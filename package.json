{
  "name": "khedmafinal-multi-agents",
  "version": "1.0.0",
  "description": "KhedmaFinal - Plateforme moderne de recherche d'emploi avec IA et système multi-agents",
  "main": "src/main.tsx",
  "scripts": {
    "dev": "vite --port 3000 --host",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "deno test --allow-all",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "orchestrator:dev": "deno run --allow-all orchestrator/agent-orchestrator.ts",
    "deploy": "supabase functions deploy",
    "deploy:orchestrator": "supabase functions deploy agent-orchestrator",
    "deploy:cv-analyzer": "supabase functions deploy cv-analyzer-agent",
    "deploy:matching": "supabase functions deploy matching-agent",
    "deploy:content-writer": "supabase functions deploy content-writer-agent",
    "deploy:support": "supabase functions deploy support-agent",
    "deploy:moderation": "supabase functions deploy moderation-agent",
    "deploy:analytics": "supabase functions deploy analytics-agent",
    "setup:db": "psql -f utils/database-setup.sql",
    "format": "deno fmt"
  },
  "keywords": [
    "ai",
    "multi-agents",
    "job-matching",
    "cv-analysis",
    "content-generation",
    "supabase",
    "typescript",
    "khedmafinal",
    "tunisia",
    "employment"
  ],
  "author": "Manus AI",
  "license": "MIT",
  "dependencies": {
    "@reduxjs/toolkit": "^2.2.7",
    "@supabase/supabase-js": "^2.39.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "lovable-tagger": "^1.1.8",
    "lucide-react": "^0.445.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hot-toast": "^2.4.1",
    "react-redux": "^9.1.2",
    "react-router-dom": "^6.26.1",
    "tailwind-merge": "^2.5.3"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.0",
    "postcss": "^8.4.43",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.0.0",
    "vite": "^5.4.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "deno": ">=1.40.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/medbjaoui/khedmafinal.git"
  },
  "bugs": {
    "url": "https://github.com/medbjaoui/khedmafinal/issues"
  },
  "homepage": "https://github.com/medbjaoui/khedmafinal#readme"
}
