# ============================================================================
# CONFIGURATION SUPABASE (EXISTANTE)
# ============================================================================
REACT_APP_SUPABASE_URL=https://your-project.supabase.co
REACT_APP_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# ============================================================================
# GOOGLE CLOUD AI SERVICES
# ============================================================================
# Projet Google Cloud
GOOGLE_CLOUD_PROJECT_ID=your-gcp-project-id

# Clé API Gemini Pro
GEMINI_API_KEY=your_gemini_api_key

# Credentials pour Document AI (chemin vers le fichier JSON)
GOOGLE_APPLICATION_CREDENTIALS=./google-credentials.json

# ============================================================================
# GROQ (OPTIONNEL - FALLBACK)
# ============================================================================
GROQ_API_KEY=your_groq_api_key

# ============================================================================
# CONFIGURATION DES AGENTS
# ============================================================================
# Activer/désactiver les agents individuellement
AGENT_CV_ANALYZER_ENABLED=true
AGENT_MATCHING_ENABLED=true
AGENT_CONTENT_WRITER_ENABLED=true
AGENT_SUPPORT_ENABLED=true
AGENT_MODERATION_ENABLED=true
AGENT_ANALYTICS_ENABLED=true

# Limites de ressources globales
MAX_CONCURRENT_TASKS_PER_AGENT=5
DEFAULT_TASK_TIMEOUT_SECONDS=300
MAX_RETRY_ATTEMPTS=3

# ============================================================================
# CONFIGURATION SPÉCIFIQUE CV ANALYZER
# ============================================================================
CV_ANALYZER_MAX_FILE_SIZE_MB=10
CV_ANALYZER_SUPPORTED_FORMATS=application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document
CV_ANALYZER_ANALYSIS_DEPTH=complete
CV_ANALYZER_QUALITY_THRESHOLD=60
CV_ANALYZER_COMPLETENESS_THRESHOLD=40

# ============================================================================
# CONFIGURATION SPÉCIFIQUE MATCHING AGENT
# ============================================================================
MATCHING_DEFAULT_SKILLS_WEIGHT=0.35
MATCHING_DEFAULT_EXPERIENCE_WEIGHT=0.25
MATCHING_DEFAULT_EDUCATION_WEIGHT=0.15
MATCHING_DEFAULT_LOCATION_WEIGHT=0.10
MATCHING_DEFAULT_SALARY_WEIGHT=0.10
MATCHING_DEFAULT_LANGUAGE_WEIGHT=0.05

MATCHING_STRONG_THRESHOLD=80
MATCHING_MODERATE_THRESHOLD=60
MATCHING_WEAK_THRESHOLD=40

# ============================================================================
# CONFIGURATION SPÉCIFIQUE CONTENT WRITER
# ============================================================================
CONTENT_WRITER_SUPPORTED_LANGUAGES=fr,ar,en
CONTENT_WRITER_DEFAULT_TONE=professional
CONTENT_WRITER_DEFAULT_LENGTH=medium
CONTENT_WRITER_MAX_CONTENT_LENGTH=5000

# ============================================================================
# CONFIGURATION SPÉCIFIQUE SUPPORT AGENT
# ============================================================================
SUPPORT_AGENT_SUPPORTED_LANGUAGES=fr,ar
SUPPORT_AGENT_MAX_RESPONSE_LENGTH=500
SUPPORT_AGENT_ESCALATION_COMPLEXITY_THRESHOLD=0.8
SUPPORT_AGENT_ESCALATION_SENTIMENT_THRESHOLD=0.3
SUPPORT_AGENT_MAX_CONVERSATION_LENGTH=10

# ============================================================================
# CONFIGURATION SPÉCIFIQUE MODERATION AGENT
# ============================================================================
MODERATION_AUTO_REJECT_THRESHOLD=0.9
MODERATION_FLAG_FOR_REVIEW_THRESHOLD=0.7
MODERATION_AUTO_APPROVE_THRESHOLD=0.3

# ============================================================================
# CONFIGURATION SPÉCIFIQUE ANALYTICS AGENT
# ============================================================================
ANALYTICS_DATA_RETENTION_DAYS=90
ANALYTICS_AGGREGATED_DATA_RETENTION_DAYS=730
ANALYTICS_MAX_ANALYSIS_PERIOD_DAYS=365

# ============================================================================
# MONITORING ET LOGGING
# ============================================================================
# Niveau de logging (debug, info, warn, error)
LOG_LEVEL=info

# Activer le monitoring détaillé
ENABLE_DETAILED_MONITORING=true

# Intervalle de vérification de santé des agents (secondes)
HEALTH_CHECK_INTERVAL_SECONDS=30

# Rétention des logs (jours)
LOG_RETENTION_DAYS=30

# ============================================================================
# SÉCURITÉ
# ============================================================================
# Chiffrement des données sensibles
ENCRYPTION_KEY=your_32_character_encryption_key

# Rate limiting (requêtes par minute par utilisateur)
RATE_LIMIT_PER_USER_PER_MINUTE=60

# Timeout pour les requêtes externes (millisecondes)
EXTERNAL_API_TIMEOUT_MS=30000

# ============================================================================
# DÉVELOPPEMENT ET DEBUG
# ============================================================================
# Mode développement
NODE_ENV=development

# Activer les logs de debug pour les agents
DEBUG_AGENTS=false

# Simuler les réponses IA (pour les tests sans API keys)
SIMULATE_AI_RESPONSES=false

# Désactiver les vérifications de sécurité en développement
DISABLE_SECURITY_CHECKS=false

# ============================================================================
# MÉTRIQUES ET ANALYTICS
# ============================================================================
# Activer la collecte de métriques
ENABLE_METRICS_COLLECTION=true

# URL webhook pour les alertes critiques
ALERT_WEBHOOK_URL=https://your-monitoring-service.com/webhook

# Seuils d'alerte
ALERT_ERROR_RATE_THRESHOLD=0.05
ALERT_RESPONSE_TIME_THRESHOLD_MS=5000
ALERT_QUEUE_SIZE_THRESHOLD=100

# ============================================================================
# INTÉGRATIONS EXTERNES
# ============================================================================
# Webhook pour les notifications Slack (optionnel)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your/slack/webhook

# Email pour les notifications critiques
ADMIN_EMAIL=admin@khedmafinal.com

# URL de base de l'application (pour les liens dans les notifications)
APP_BASE_URL=https://khedmafinal.com
